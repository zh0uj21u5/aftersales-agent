# Adapter: anthropic | openai (aliases: deepseek | qwen | glm use OPENAI_* variables)
LLM_PROVIDER=anthropic

# Anthropic-compatible endpoint (official, proxy, or e.g. DeepSeek's anthropic endpoint)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# OpenAI-compatible endpoint (OpenAI, Qwen/DashScope, GLM, DeepSeek ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=

MODEL_ID=

# Configuration precedence: explicit arguments > process environment > .env.
# Use a tool-calling model ID and the endpoint supplied by your provider.

# Harness limits
MAX_STEPS=30
TOOL_OUTPUT_MAX_CHARS=8000

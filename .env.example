# Adapter: anthropic | openai (aliases: deepseek | qwen | glm use OPENAI_* variables)
LLM_PROVIDER=anthropic

# Anthropic-compatible endpoint (official, proxy, or e.g. DeepSeek's anthropic endpoint)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# OpenAI-compatible endpoint (OpenAI, Qwen/DashScope, GLM, DeepSeek ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=

MODEL_ID=

# Configuration precedence: explicit arguments > process environment > .env.
# Use a tool-calling model ID and the endpoint supplied by your provider.

# Harness limits
MAX_STEPS=30
TOOL_OUTPUT_MAX_CHARS=8000

# Production gateway (serve --mode prod). These Compose credentials are for local development.
# DATABASE_URL=postgresql://aftersales:aftersales_dev@127.0.0.1:5432/aftersales
# REDIS_URL=redis://127.0.0.1:6379/0
# JWT_ALGORITHM=HS256
# JWT_KEY=
# JWT_ISSUER=
# JWT_AUDIENCE=
# DAILY_BUDGET_MICROCENTS=10000000
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# For a model outside the built-in price table, set both USD rates per million tokens.
# MODEL_INPUT_USD_PER_MTOK=
# MODEL_OUTPUT_USD_PER_MTOK=

# M10 external channels. The sandbox stays in memory and is for a single demo process.
# GATEWAY_MODE=http
# PAYMENT_GATEWAY_URL=
# PAYMENT_GATEWAY_TOKEN=
# FULFILLMENT_GATEWAY_URL=
# FULFILLMENT_GATEWAY_TOKEN=
# PAYMENT_WEBHOOK_SECRET=
# OUTBOX_READY_MAX_AGE_SECONDS=300
# LLM_ROUTING_CONFIG=
